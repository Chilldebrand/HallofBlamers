# Copy to .env (never commit .env). On the Linux box, ops/setup.sh does this for you and
# prompts for each value below — see docs/RUNBOOK.md for the full first-time setup walkthrough.

# Where the SQLite database lives. Local (non-Docker) dev only — inside Docker Compose this is
# always overridden to /data/league.db by docker-compose.yml (the ./data:/data volume), regardless
# of what's set here.
DATABASE_PATH=./data/league.db

# Signs session JWTs (src/server/auth/session.ts). Any long random string — ops/setup.sh generates
# one automatically with `openssl rand -hex 32`; you should never need to touch this by hand.
# Changing it logs everyone out (all existing session cookies stop verifying).
SESSION_SECRET=change-me-to-a-long-random-string

# Powers the AI-written weekly recaps (src/server/ai/). Get one from
# https://console.anthropic.com -> API Keys. Optional — leave blank and the rest of the site
# works fine, the admin recap-generation page just won't.
ANTHROPIC_API_KEY=

# Lets Cloudflare route your public domain (or Tailscale Funnel, see docs/RUNBOOK.md) to this box
# without opening any port on your router. Create the tunnel in the Cloudflare Zero Trust
# dashboard (Networks -> Tunnels -> Create a tunnel -> Cloudflared), then copy the token it gives
# you here. Optional at first-setup time — until it's set, the `cloudflared` container will just
# keep restarting and the site won't be reachable from the internet, but `web`/`worker` run fine
# regardless.
CLOUDFLARE_TUNNEL_TOKEN=

# The numeric id in your league's ESPN URL, e.g. .../leagueId=1690915927 -> 1690915927.
ESPN_LEAGUE_ID=1690915927

# Private-league ESPN auth cookies, from a browser logged into ESPN Fantasy: open your league,
# open DevTools -> Application/Storage -> Cookies -> fantasy.espn.com, and copy these two values
# verbatim (SWID keeps its surrounding {curly braces}; espn_s2 stays URL-encoded, don't decode it).
# Only needed for a private league — leave both blank for a public one. ESPN periodically expires
# these, and once the worker's first successful sync has run, the DATABASE's copy (app_settings)
# wins over whatever's in this file from then on — editing this file again later does NOT rotate
# expired cookies by itself. See docs/RUNBOOK.md's "ESPN credentials expired" incident entry for
# the actual rotation procedure.
ESPN_S2=
ESPN_SWID=
