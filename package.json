{
  "name": "hallofblamers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env worker/index.ts",
    "backfill": "tsx --env-file-if-exists=.env src/server/espn/backfill.ts",
    "normalize": "tsx --env-file-if-exists=.env src/server/sync/normalize-cli.ts",
    "seed:suggest": "tsx --env-file-if-exists=.env src/server/sync/seed-suggest-cli.ts",
    "seed:managers": "tsx --env-file-if-exists=.env src/server/auth/seed-managers-cli.ts",
    "stats:build": "tsx --env-file-if-exists=.env src/server/stats/run-build.ts",
    "winprob:backtest": "tsx --env-file-if-exists=.env src/server/stats/backtest-cli.ts",
    "playoffodds:backtest": "tsx --env-file-if-exists=.env src/server/stats/playoffOddsBacktest-cli.ts",
    "backup": "tsx --env-file-if-exists=.env src/server/db/backup-cli.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "audit:identity": "node scripts/verify-identity.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "better-sqlite3": "^13.0.2",
    "croner": "^10.0.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
